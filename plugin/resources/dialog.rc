// SpeedTree Chinese Localizer - installer dialog template
#include <windows.h>

#define IDD_MAIN 1
IDD_MAIN DIALOGEX 0, 0, 250, 132
STYLE DS_SETFONT | DS_MODALFRAME | WS_CAPTION | WS_SYSMENU | WS_VISIBLE
CAPTION "SpeedTree Chinese Localizer"
FONT 9, "Segoe UI", 400, 0, 0x80
BEGIN
    LTEXT           "SpeedTree install dir (win64):", -1, 10, 12, 200, 10
    EDITTEXT        1003, 10, 26, 180, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "Browse...", 1004, 196, 26, 44, 15
    LTEXT           " ", 1005, 10, 50, 230, 40
    PUSHBUTTON      "Install", 1001, 80, 106, 80, 18
    PUSHBUTTON      "Uninstall", 1002, 168, 106, 80, 18
END
